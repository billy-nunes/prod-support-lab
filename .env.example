# Copy to .env to override defaults. .env is gitignored. These are lab-only passwords.
PG_SUPERUSER_PASSWORD=postgres
APP_DB_PASSWORD=shop_app_pw
WORKER_DB_PASSWORD=shop_worker_pw
# 1 = ~1M orders. Use 0.05 on small machines.
SEED_SCALE=1
LOADGEN_RPS=4

# Small machine (1 GB RAM, e.g. t2/t3.micro)? Use the .env in docs/EC2.md instead.
